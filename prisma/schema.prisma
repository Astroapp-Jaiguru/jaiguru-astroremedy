generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String    @id @default(cuid())
  name                 String
  email                String    @unique
  passwordHash         String @map("passwordhash")
  role                 Role      @default(ADMIN)
  phone                String?
  avatarUrl            String?
  isActive             Boolean   @default(true) @map("isactive")
  lastLoginAt          DateTime? @map("lastloginat")
  passwordResetToken   String?   @unique @map("passwordresettoken")
  passwordResetExpires DateTime? @map("passwordresetexpires")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Organization {
  id              Int               @id @default(autoincrement())
  name            String            @db.VarChar(255)
  type            Role              @default(CUSTOMER)
  isactive        Boolean?          @default(true)
  sortorder       Int?              @default(0)
  createdat       DateTime?         @default(now()) @db.Timestamp(6)
  updatedat       DateTime?         @default(now()) @db.Timestamp(6)
  BankAccount     BankAccount[]
  KYCCase         KYCCase[]
  SupplierProfile SupplierProfile[]
  Vendor          Vendor[]
}

model Vendor {
  id             Int            @id @default(autoincrement())
  organizationid Int?
  businessname   String         @db.VarChar(255)
  contactperson  String         @db.VarChar(255)
  phone          String?        @db.VarChar(50)
  gstnumber      String?        @db.VarChar(50)
  pannumber      String?        @db.VarChar(50)
  status         String?        @default("PENDING") @db.VarChar(20)
  commissionrate Decimal?       @db.Decimal(5, 2)
  paymentmode    String?        @default("MANUAL") @db.VarChar(20)
  kyccompletedat DateTime?      @db.Timestamp(6)
  createdat      DateTime?      @default(now()) @db.Timestamp(6)
  updatedat      DateTime?      @default(now()) @db.Timestamp(6)
  Organization   Organization?  @relation(fields: [organizationid], references: [id], onUpdate: NoAction)
  VendorOrder    VendorOrder[]
  VendorPayout   VendorPayout[]
}

model SupplierProfile {
  id             Int           @id @default(autoincrement())
  organizationid Int?
  businessname   String        @db.VarChar(255)
  gstnumber      String?       @db.VarChar(50)
  pannumber      String?       @db.VarChar(50)
  status         String?       @default("PENDING") @db.VarChar(20)
  commissionrate Decimal?      @db.Decimal(5, 2)
  paymentmode    String?       @default("MANUAL") @db.VarChar(20)
  kyccompletedat DateTime?     @db.Timestamp(6)
  createdat      DateTime?     @default(now()) @db.Timestamp(6)
  updatedat      DateTime?     @default(now()) @db.Timestamp(6)
  Organization   Organization? @relation(fields: [organizationid], references: [id], onUpdate: NoAction)
}

model KYCCase {
  id             Int           @id @default(autoincrement())
  organizationid Int?
  provider       String?       @db.VarChar(50)
  providercaseid String?       @db.VarChar(255)
  status         String?       @default("PENDING") @db.VarChar(20)
  riskscore      Int?
  decision       String?       @db.VarChar(20)
  reasoncodes    Json?         @default("[]")
  submittedat    DateTime?     @default(now()) @db.Timestamp(6)
  verifiedat     DateTime?     @db.Timestamp(6)
  nextreviewat   DateTime?     @db.Timestamp(6)
  createdat      DateTime?     @default(now()) @db.Timestamp(6)
  updatedat      DateTime?     @default(now()) @db.Timestamp(6)
  Organization   Organization? @relation(fields: [organizationid], references: [id], onUpdate: NoAction)
  KYCDocument    KYCDocument[]
}

model KYCDocument {
  id                 Int       @id @default(autoincrement())
  kyccaseid          Int?
  documenttype       String    @db.VarChar(50)
  storagekey         String    @db.VarChar(500)
  sha256             String    @db.VarChar(64)
  mimetype           String    @db.VarChar(100)
  verificationstatus String?   @default("pending") @db.VarChar(20)
  expiresat          DateTime? @db.Timestamp(6)
  createdat          DateTime? @default(now()) @db.Timestamp(6)
  updatedat          DateTime? @default(now()) @db.Timestamp(6)
  KYCCase            KYCCase?  @relation(fields: [kyccaseid], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model BankAccount {
  id             Int           @id @default(autoincrement())
  organizationid Int?
  accounttype    String        @db.VarChar(20)
  bankname       String        @db.VarChar(255)
  encryptedblob  Bytes
  iv             Bytes
  authtag        Bytes
  isprimary      Boolean?      @default(false)
  createdat      DateTime?     @default(now()) @db.Timestamp(6)
  updatedat      DateTime?     @default(now()) @db.Timestamp(6)
  Organization   Organization? @relation(fields: [organizationid], references: [id], onUpdate: NoAction)
}

model MarketplaceSettings {
  id                          Int       @id @default(1)
  enabled                     Boolean?  @default(false)
  fulfillmentmode             String?   @default("A") @db.VarChar(1)
  globalcommissionrate        Int?      @default(10)
  registrationopen            Boolean?  @default(true)
  vendorproductuploadsenabled Boolean?  @default(true)
  vendoranalyticsenabled      Boolean?  @default(true)
  payoutmode                  String?   @default("MANUAL") @db.VarChar(20)
  settlementholddays          Int?      @default(7)
  createdat                   DateTime? @default(now()) @db.Timestamp(6)
  updatedat                   DateTime? @default(now()) @db.Timestamp(6)
  updatedAt                   DateTime  @default(now()) @updatedAt
}

model ProductCategory {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  description String?
  icon        String?
  imageUrl    String?
  sortOrder   Int               @default(0)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  parentId    String?
  products    Product[]
  parent      ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    ProductCategory[] @relation("CategoryTree")

  @@index([parentId])
}

model Product {
  id                    String             @id @default(cuid())
  name                  String
  slug                  String             @unique
  categoryId            String @map("categoryid")
  subcategory           String?
  sku                   String?
  mainImage             String? @map("mainimage")
  price                 Decimal            @db.Decimal(12, 2)
  discountPrice         Decimal?           @db.Decimal(12, 2) @map("discountprice")
  stockStatus           StockStatus        @default(IN_STOCK) @map("stockstatus")
  quantity              Int                @default(0)
  shortDescription      String? @map("shortdescription")
  longDescription       String? @map("longdescription")
  benefits              String[]           @default([])
  usageMethod           String? @map("usagemethod")
  material              String?
  size                  String?
  weight                String?
  color                 String?
  tags                  String[]           @default([])
  isFeatured            Boolean            @default(false) @map("isfeatured")
  isPopular             Boolean            @default(false) @map("ispopular")
  isNewArrival          Boolean            @default(false) @map("isnewarrival")
  rating                Decimal            @default(4.5) @db.Decimal(3, 2) @map("rating")
  ratingCount           Int                @default(0) @map("ratingcount")
  seoTitle              String? @map("seotitle")
  seoDescription        String? @map("seodescription")
  seoKeywords           String? @map("seokeywords")
  whatsappMessage       String? @map("whatsappmessage")
  isActive              Boolean            @default(true) @map("isactive")
  sortOrder             Int                @default(0) @map("sortorder")
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  hasCertificate        Boolean            @default(false) @map("hascertificate")
  estimatedDeliveryTime String? @map("estimateddeliverytime")
  returnPolicy          String? @map("returnpolicy")
  competitorPrice       Decimal?           @db.Decimal(12, 2) @map("competitorprice")
  costPrice             Decimal?           @db.Decimal(12, 2) @map("costprice")
  imageCredit           String? @map("imagecredit")
  imageSource           String             @default("manual") @map("imagesource")
  priceFloor            Decimal?           @db.Decimal(12, 2) @map("pricefloor")
  priceReviewedAt       DateTime? @map("pricereviewedat")
  priceSource           String             @default("manual") @map("pricesource")
  certificateLabel      String? @map("certificatelabel")
  sizeOptions           Json? @map("sizeoptions")
  navigationId          String? @map("navigationid")
  vendorId              String?            @db.VarChar(191) @map("vendorid")
  approvalStatus        String?            @default("PENDING") @db.VarChar(20) @map("approvalstatus")
  priceChanges          PriceChange[]
  category              ProductCategory    @relation(fields: [categoryId], references: [id])
  navigation            ProductNavigation? @relation(fields: [navigationId], references: [id])
  gallery               ProductImage[]

  @@index([categoryId])
  @@index([navigationId])
  @@index([isActive, isFeatured])
  @@index([isActive, isPopular])
  @@index([priceSource])
}

model ProductNavigation {
  id        String              @id @default(cuid())
  name      String
  slug      String              @unique
  kind      String?
  parentId  String? @map("parentid")
  sortOrder Int                 @default(0) @map("sortorder")
  isActive  Boolean             @default(true) @map("isactive")
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  products  Product[]
  parent    ProductNavigation?  @relation("ProductNavigationTree", fields: [parentId], references: [id])
  children  ProductNavigation[] @relation("ProductNavigationTree")

  @@index([parentId])
  @@index([isActive])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String @map("productid")
  url       String
  altText   String? @map("alttext")
  sortOrder Int     @default(0) @map("sortorder")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model PriceChange {
  id        String   @id @default(cuid())
  productId String?
  serviceId String?
  field     String   @default("price")
  oldValue  Decimal? @db.Decimal(12, 2)
  newValue  Decimal? @db.Decimal(12, 2)
  reason    String?
  source    String   @default("manual")
  createdAt DateTime @default(now())
  product   Product? @relation(fields: [productId], references: [id])
  service   Service? @relation(fields: [serviceId], references: [id])

  @@index([productId])
  @@index([serviceId])
  @@index([createdAt])
}

model ServiceCategory {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  description String?
  icon        String?
  imageUrl    String?
  sortOrder   Int               @default(0)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  parentId    String?
  services    Service[]
  parent      ServiceCategory?  @relation("ServiceCategoryTree", fields: [parentId], references: [id])
  children    ServiceCategory[] @relation("ServiceCategoryTree")

  @@index([parentId])
}

model Service {
  id               String          @id @default(cuid())
  name             String
  slug             String          @unique
  categoryId       String @map("categoryid")
  mode             ServiceMode     @default(ONLINE)
  duration         String?
  price            Decimal?        @db.Decimal(12, 2)
  priceLabel       String? @map("pricelabel")
  imageUrl         String? @map("imageurl")
  shortDescription String? @map("shortdescription")
  longDescription  String? @map("longdescription")
  benefits         String[]        @default([])
  syllabus         String[]        @default([])
  serviceArea      String? @map("servicearea")
  faqs             Json?
  whatsappMessage  String? @map("whatsappmessage")
  isFeatured       Boolean         @default(false) @map("isfeatured")
  seoTitle         String? @map("seotitle")
  seoDescription   String? @map("seodescription")
  seoKeywords      String? @map("seokeywords")
  isActive         Boolean         @default(true) @map("isactive")
  sortOrder        Int             @default(0) @map("sortorder")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  slotDuration     Int? @map("slotduration")
  competitorPrice  Decimal?        @db.Decimal(12, 2) @map("competitorprice")
  priceFloor       Decimal?        @db.Decimal(12, 2) @map("pricefloor")
  priceReviewedAt  DateTime? @map("pricereviewedat")
  priceSource      String          @default("manual") @map("pricesource")
  priceChanges     PriceChange[]
  category         ServiceCategory @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([isActive, isFeatured])
  @@index([priceSource])
}

model ConsultationTopic {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  description     String
  longDescription String @map("longdescription")
  iconKey         String   @default("star") @map("iconkey")
  fee             String   @default("₹700")
  homeFee         String   @default("₹1,500") @map("homefee")
  durationMinutes Int      @default(30) @map("durationminutes")
  keywords        String[] @default([])
  benefits        String[] @default([])
  isActive        Boolean  @default(true) @map("isactive")
  sortOrder       Int      @default(0) @map("sortorder")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model Article {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  featuredImage   String? @map("featuredimage")
  content         String
  category        String
  tags            String[] @default([])
  metaTitle       String? @map("metatitle")
  metaDescription String? @map("metadescription")
  authorName      String @map("authorname")
  publishDate     DateTime @db.Date @map("publishdate")
  isActive        Boolean  @default(true) @map("isactive")
  isFeatured      Boolean  @default(false) @map("isfeatured")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive, isFeatured, publishDate])
}

model BookingBlock {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  allDay    Boolean  @default(false)
  timeSlots String[] @default([])
  reason    String?
  createdAt DateTime @default(now())

  @@index([date])
}

model Order {
  id                    String        @id @default(cuid())
  customerName          String @map("customername")
  phone                 String
  whatsappNumber        String? @map("whatsappnumber")
  itemName              String @map("itemname")
  itemType              OrderItemType @default(SERVICE) @map("itemtype")
  amount                Decimal?      @db.Decimal(12, 2)
  amountLabel           String? @map("amountlabel")
  preferredDate         String? @map("preferreddate")
  preferredTime         String? @map("preferredtime")
  note                  String?
  status                OrderStatus   @default(PENDING)
  source                String        @default("website")
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  deliveryAddress       String? @map("deliveryaddress")
  city                  String?
  state                 String?
  pincode               String?
  paymentMethod         String? @map("paymentmethod")
  paymentStatus         String? @map("paymentstatus")
  razorpayOrderId       String? @map("razorpayorderid")
  razorpayPaymentId     String? @map("razorpaypaymentid")
  razorpaySignature     String? @map("razorpaysignature")
  courierName           String? @map("couriername")
  trackingNumber        String? @map("trackingnumber")
  trackingUrl           String? @map("trackingurl")
  trackingSentAt        DateTime? @map("trackingsentat")
  email                 String?
  preferredMode         String? @map("preferredmode")
  birthDate             String? @map("birthdate")
  birthTime             String? @map("birthtime")
  birthPlace            String? @map("birthplace")
  vendorId              String?       @db.VarChar(191)
  fulfillmentmode       String?       @default("A") @db.VarChar(1)
  commissionamount      Decimal?      @default(0) @db.Decimal(12, 2)
  taxamount             Decimal?      @default(0) @db.Decimal(12, 2)
  netamount             Decimal?      @default(0) @db.Decimal(12, 2)
  vendorpayoutstatus    String?       @default("PENDING") @db.VarChar(20)
  vendorpayoutmethod    String?       @default("MANUAL") @db.VarChar(20)
  vendorpayoutreference String?       @db.VarChar(255)
  VendorOrder           VendorOrder[]

  @@index([status])
  @@index([createdAt])
  @@index([razorpayOrderId])
}

model GalleryImage {
  id          String   @id @default(cuid())
  title       String?
  description String?
  imageUrl    String @map("imageurl")
  altText     String? @map("alttext")
  category    String?
  isFeatured  Boolean  @default(false) @map("isfeatured")
  isActive    Boolean  @default(true) @map("isactive")
  sortOrder   Int      @default(0) @map("sortorder")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Video {
  id           String   @id @default(cuid())
  title        String
  description  String?
  videoUrl     String @map("videourl")
  thumbnailUrl String? @map("thumbnailurl")
  category     String?
  isFeatured   Boolean  @default(false) @map("isfeatured")
  isActive     Boolean  @default(true) @map("isactive")
  sortOrder    Int      @default(0) @map("sortorder")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model YoutubeVideo {
  id           String   @id @default(cuid())
  title        String
  description  String?
  youtubeId    String @map("youtubeid")
  youtubeUrl   String @map("youtubeurl")
  thumbnailUrl String? @map("thumbnailurl")
  category     String?
  isFeatured   Boolean  @default(false) @map("isfeatured")
  isActive     Boolean  @default(true) @map("isactive")
  sortOrder    Int      @default(0) @map("sortorder")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Testimonial {
  id           String   @id @default(cuid())
  customerName String @map("customername")
  photoUrl     String? @map("photourl")
  rating       Int      @default(5)
  text         String
  serviceRef   String? @map("serviceref")
  location     String?
  isApproved   Boolean  @default(false) @map("isapproved")
  isFeatured   Boolean  @default(false) @map("isfeatured")
  sortOrder    Int      @default(0) @map("sortorder")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Announcement {
  id              String   @id @default(cuid())
  title           String?
  text            String
  textColor       String   @default("#FFFFFF") @map("textcolor")
  gradientColor   String?
  backgroundColor String   @default("#4C1D95") @map("backgroundcolor")
  fontSize        Int      @default(16) @map("fontsize")
  fontStyle       String? @map("fontstyle")
  speed           Int      @default(30)
  isActive        Boolean  @default(true) @map("isactive")
  sortOrder       Int      @default(0) @map("sortorder")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model HomepageSection {
  id         String   @id @default(cuid())
  sectionKey String   @unique @map("sectionkey")
  title      String?
  subtitle   String?
  content    Json?
  settings   Json?
  isVisible  Boolean  @default(true) @map("isvisible")
  sortOrder  Int      @default(0) @map("sortorder")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ThemeSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SeoSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SocialLink {
  id        String   @id @default(cuid())
  platform  String   @unique
  url       String
  icon      String?
  isActive  Boolean  @default(true) @map("isactive")
  sortOrder Int      @default(0) @map("sortorder")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  source    String   @default("footer")
  isActive  Boolean  @default(true) @map("isactive")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model LegalPage {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  content        String
  seoTitle       String? @map("seotitle")
  seoDescription String? @map("seodescription")
  isActive       Boolean  @default(true) @map("isactive")
  sortOrder      Int      @default(0) @map("sortorder")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String?
  sortOrder Int      @default(0) @map("sortorder")
  isActive  Boolean  @default(true) @map("isactive")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model SiteImage {
  id        String   @id @default(cuid())
  filename  String
  mimeType  String @map("mimetype")
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model ContactMessage {
  id              String        @id @default(cuid())
  name            String
  phone           String
  whatsappNumber  String? @map("whatsappnumber")
  serviceInterest String? @map("serviceinterest")
  message         String?
  preferredDate   String? @map("preferreddate")
  preferredTime   String? @map("preferredtime")
  status          RequestStatus @default(NEW)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Shipment {
  id                  Int          @id @default(autoincrement())
  vendor_order_id     Int?
  carrier             String?      @db.VarChar(100)
  awb_number          String?      @db.VarChar(50)
  tracking_number     String?      @db.VarChar(50)
  status              String?      @default("PENDING") @db.VarChar(20)
  shipped_at          DateTime?    @db.Timestamp(6)
  delivered_at        DateTime?    @db.Timestamp(6)
  pickup_scheduled_at DateTime?    @db.Timestamp(6)
  carrier_url         String?      @db.VarChar(500)
  created_at          DateTime?    @default(now()) @db.Timestamp(6)
  updated_at          DateTime?    @default(now()) @db.Timestamp(6)
  VendorOrder         VendorOrder? @relation(fields: [vendor_order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model ShippingConfig {
  id                       Int       @id @default(autoincrement())
  carrier                  String    @db.VarChar(100)
  min_order_value          Decimal?  @default(0) @db.Decimal(12, 2)
  max_order_value          Decimal?  @default(0) @db.Decimal(12, 2)
  base_shipping_fee        Decimal?  @default(0) @db.Decimal(12, 2)
  per_kg_fee               Decimal?  @default(0) @db.Decimal(12, 2)
  estimated_delivery_range String?   @db.VarChar(50)
  is_active                Boolean?  @default(true)
  created_at               DateTime? @default(now()) @db.Timestamp(6)
  updated_at               DateTime? @default(now()) @db.Timestamp(6)
}

model VendorOrder {
  id                Int            @id @default(autoincrement())
  parent_order_id   String?        @db.VarChar(191)
  vendor_id         Int?
  status            String?        @default("PENDING") @db.VarChar(20)
  gross_amount      Decimal?       @default(0) @db.Decimal(12, 2)
  commission_amount Decimal?       @default(0) @db.Decimal(12, 2)
  shipping_amount   Decimal?       @default(0) @db.Decimal(12, 2)
  tax_amount        Decimal?       @default(0) @db.Decimal(12, 2)
  net_amount        Decimal?       @default(0) @db.Decimal(12, 2)
  payout_status     String?        @default("PENDING") @db.VarChar(20)
  payout_method     String?        @default("MANUAL") @db.VarChar(20)
  payout_reference  String?        @db.VarChar(255)
  created_at        DateTime?      @default(now()) @db.Timestamp(6)
  updated_at        DateTime?      @default(now()) @db.Timestamp(6)
  Shipment          Shipment[]
  Order             Order?         @relation(fields: [parent_order_id], references: [id], onUpdate: NoAction)
  Vendor            Vendor?        @relation(fields: [vendor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  VendorPayout      VendorPayout[]
}

model VendorPayout {
  id                  Int          @id @default(autoincrement())
  vendor_order_id     Int?
  vendor_id           Int?
  amount              Decimal?     @default(0) @db.Decimal(12, 2)
  commission_amount   Decimal?     @default(0) @db.Decimal(12, 2)
  tax_amount          Decimal?     @default(0) @db.Decimal(12, 2)
  net_amount          Decimal?     @default(0) @db.Decimal(12, 2)
  payout_status       String?      @default("PENDING") @db.VarChar(20)
  payout_method       String?      @default("MANUAL") @db.VarChar(20)
  payout_reference    String?      @db.VarChar(255)
  payout_initiated_at DateTime?    @db.Timestamp(6)
  payout_completed_at DateTime?    @db.Timestamp(6)
  created_at          DateTime?    @default(now()) @db.Timestamp(6)
  updated_at          DateTime?    @default(now()) @db.Timestamp(6)
  Vendor              Vendor?      @relation(fields: [vendor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  VendorOrder         VendorOrder? @relation(fields: [vendor_order_id], references: [id], onUpdate: NoAction)
}

