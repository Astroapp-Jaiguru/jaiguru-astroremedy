// JAIGURU ASTROREMEDY - Prisma Schema
// Premium Astrology, Spiritual Remedy, Vastu, Numerology, Gemstone, Yoga & Product CMS Website

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  EDITOR
  VENDOR
  BUYER
  SUPPLIER
  CUSTOMER
}

enum OrganizationType {
  VENDOR
  BUYER
  SUPPLIER
  INTERNAL
}

enum PartnerStatus {
  PENDING
  APPROVED
  REJECTED
  HOLD
  SUSPENDED
}

enum PaymentMode {
  MANUAL
  BANK_TRANSFER
  UPI
  RAZORPAY
}

enum KYCStatus {
  NOT_STARTED
  PENDING
  APPROVED
  REJECTED
  HOLD
}

enum FulfillmentMode {
  SELF
  VENDOR
  HYBRID
}

enum PayoutMode {
  MANUAL
  AUTO
}

enum ServiceMode {
  ONLINE
  OFFLINE
  HOME_SERVICE
}

enum StockStatus {
  IN_STOCK
  OUT_OF_STOCK
  PRE_ORDER
}

enum RequestStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  COMPLETED
  CANCELLED
}

enum OrderItemType {
  SERVICE
  PRODUCT
}

// ---------------------------------------------------------------------------
// Users & Authentication
// ---------------------------------------------------------------------------

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  passwordHash        String
  role                Role      @default(ADMIN)
  phone               String?
  avatarUrl           String?
  isActive            Boolean   @default(true)
  lastLoginAt         DateTime?
  passwordResetToken  String?   @unique
  passwordResetExpires DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  organizations       Organization[]
  vendorProfile       Vendor?
  supplierProfile      SupplierProfile?
}

// ---------------------------------------------------------------------------
// Marketplace foundation
// ---------------------------------------------------------------------------

model Organization {
  id          String           @id @default(cuid())
  name        String
  type        OrganizationType
  isActive    Boolean          @default(true)
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       User[]
  vendors     Vendor[]
  suppliers   SupplierProfile[]
  kycCases    KYCCase[]
  bankAccounts BankAccount[]

  @@index([type, isActive])
}

model Vendor {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId          String?       @unique
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  businessName    String
  contactPerson   String
  phone           String
  gstNumber       String?
  panNumber       String?
  status          PartnerStatus @default(PENDING)
  commissionRate  Decimal       @default(0) @db.Decimal(5, 2)
  paymentMode     PaymentMode   @default(BANK_TRANSFER)
  kycCompletedAt  DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([organizationId, status])
  products         Product[]
}

model SupplierProfile {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId          String?       @unique
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  businessName    String
  gstNumber       String?
  panNumber       String?
  status          PartnerStatus @default(PENDING)
  commissionRate  Decimal       @default(0) @db.Decimal(5, 2)
  paymentMode     PaymentMode   @default(BANK_TRANSFER)
  kycCompletedAt  DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([organizationId, status])
  products         Product[]
}

model KYCCase {
  id             String      @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       String
  providerCaseId String?
  status         KYCStatus   @default(NOT_STARTED)
  riskScore      Decimal?    @db.Decimal(5, 2)
  decision       String?
  reasonCodes    String[]    @default([])
  submittedAt    DateTime?
  verifiedAt     DateTime?
  nextReviewAt   DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  documents      KYCDocument[]

  @@unique([provider, providerCaseId])
  @@index([organizationId, status])
}

model KYCDocument {
  id                 String    @id @default(cuid())
  kycCaseId          String
  kycCase            KYCCase   @relation(fields: [kycCaseId], references: [id], onDelete: Cascade)
  documentType       String
  storageKey         String
  sha256             String
  mimetype           String
  verificationStatus KYCStatus @default(PENDING)
  expiresAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([kycCaseId, verificationStatus])
}

model BankAccount {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accountType    String
  bankName       String
  encryptedBlob  String
  iv             String
  authTag        String
  isPrimary      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, isPrimary])
}

model MarketplaceSettings {
  id                         String         @id @default(cuid())
  enabled                    Boolean        @default(false)
  fulfillmentMode            FulfillmentMode @default(HYBRID)
  globalCommissionRate       Decimal        @default(0) @db.Decimal(5, 2)
  registrationOpen           Boolean        @default(true)
  vendorProductUploadsEnabled Boolean       @default(false)
  vendorAnalyticsEnabled     Boolean        @default(false)
  payoutMode                 PayoutMode     @default(MANUAL)
  settlementHoldDays         Int            @default(7)
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt
}

// ---------------------------------------------------------------------------
// Products
// ---------------------------------------------------------------------------

model ProductCategory {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String?
  icon        String?
  imageUrl    String?
  parentId    String?
  parent      ProductCategory? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    ProductCategory[] @relation("CategoryTree")
  sortOrder   Int              @default(0)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  products    Product[]

  @@index([parentId])
}

model Product {
  id               String         @id @default(cuid())
  name             String
  slug             String         @unique
  categoryId       String
  category         ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  navigationId     String?
  navigation       ProductNavigation? @relation(fields: [navigationId], references: [id], onDelete: SetNull)
  subcategory      String?
  sku              String?
  mainImage        String?
  gallery          ProductImage[]
  price            Decimal        @db.Decimal(12, 2)
  discountPrice    Decimal?       @db.Decimal(12, 2)
  // Dynamic pricing engine (safe version): competitor reference price, the
  // cost price used to derive the minimum floor (cost * 1.15), and an
  // explicit floor override. priceSource tracks provenance for the audit log.
  costPrice        Decimal?       @db.Decimal(12, 2)
  competitorPrice  Decimal?       @db.Decimal(12, 2)
  priceFloor       Decimal?       @db.Decimal(12, 2)
  priceSource      String         @default("manual") // manual | competitor
  priceReviewedAt  DateTime?
  // Image pipeline provenance (manual | unsplash | ai) + optional credit.
  imageSource      String         @default("manual")
  imageCredit      String?
  stockStatus      StockStatus    @default(IN_STOCK)
  quantity         Int            @default(0)
  shortDescription String?
  longDescription  String?
  returnPolicy     String?
  benefits         String[]       @default([])
  usageMethod      String?
  material         String?
  size             String?
  sizeOptions      Json? // [{ label, price }] — size selector options (grouped products)
  weight           String?
  color            String?
  tags             String[]       @default([])
  estimatedDeliveryTime String?
  hasCertificate   Boolean        @default(false)
  certificateLabel String?
  isFeatured       Boolean        @default(false)
  isPopular        Boolean        @default(false)
  isNewArrival     Boolean        @default(false)
  rating           Decimal        @default(4.5) @db.Decimal(3, 2)
  ratingCount      Int            @default(0)
  seoTitle         String?
  seoDescription   String?
  seoKeywords      String?
  whatsappMessage  String?
  isActive         Boolean        @default(true)
  sortOrder        Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  priceChanges     PriceChange[]

  @@index([categoryId])
  @@index([navigationId])
  @@index([isActive, isFeatured])
  @@index([isActive, isPopular])
  @@index([priceSource])
  vendorId         String?
  vendor           Vendor?   @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  approvalStatus   String    @default("PENDING") // PENDING | APPROVED | REJECTED
  supplierProfile  SupplierProfile? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierId       String?
}

model ProductNavigation {
  id        String               @id @default(cuid())
  name      String
  slug      String               @unique
  kind      String? // "size" for leaf size nodes; null for structural levels
  parentId  String?
  parent    ProductNavigation?   @relation("ProductNavigationTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  ProductNavigation[]  @relation("ProductNavigationTree")
  sortOrder Int                  @default(0)
  isActive  Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  products  Product[]

  @@index([parentId])
  @@index([isActive])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  sortOrder Int     @default(0)

  @@index([productId])
}

// ---------------------------------------------------------------------------
// Price audit trail (dynamic pricing engine). Every automatic or manual
// price change is recorded so pricing stays transparent and reversible.
// ---------------------------------------------------------------------------

model PriceChange {
  id        String   @id @default(cuid())
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  field     String   @default("price") // price | discountPrice
  oldValue  Decimal? @db.Decimal(12, 2)
  newValue  Decimal? @db.Decimal(12, 2)
  reason    String?
  source    String   @default("manual") // cron | admin | manual
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([serviceId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Services
// ---------------------------------------------------------------------------

model ServiceCategory {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String?
  icon        String?
  imageUrl    String?
  parentId    String?
  parent      ServiceCategory? @relation("ServiceCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    ServiceCategory[] @relation("ServiceCategoryTree")
  sortOrder   Int              @default(0)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  services    Service[]

  @@index([parentId])
}

model Service {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  categoryId       String
  category         ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  mode             ServiceMode   @default(ONLINE)
  duration         String?
  price            Decimal?      @db.Decimal(12, 2)
  priceLabel       String?
  // Dynamic pricing engine: competitor reference + explicit floor for digital
  // services (consultations / courses). Digital formula: competitor * 1.05.
  competitorPrice  Decimal?      @db.Decimal(12, 2)
  priceFloor       Decimal?      @db.Decimal(12, 2)
  priceSource      String        @default("manual") // manual | competitor
  priceReviewedAt  DateTime?
  imageUrl         String?
  shortDescription String?
  longDescription  String?
  benefits         String[]      @default([])
  syllabus         String[]      @default([])
  serviceArea      String?
  slotDuration     Int?
  faqs             Json?
  whatsappMessage  String?
  isFeatured       Boolean       @default(false)
  seoTitle         String?
  seoDescription   String?
  seoKeywords      String?
  isActive         Boolean       @default(true)
  sortOrder        Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  priceChanges     PriceChange[]

  @@index([categoryId])
  @@index([isActive, isFeatured])
  @@index([priceSource])
}

model ConsultationTopic {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  description     String
  longDescription String
  // Lucide icon key rendered on cards & dedicated pages (see TOPIC_ICONS map).
  iconKey         String   @default("star")
  fee             String   @default("₹700")
  homeFee         String   @default("₹1,500")
  durationMinutes Int      @default(30)
  keywords        String[] @default([])
  benefits        String[] @default([])
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// ---------------------------------------------------------------------------
// Articles (blog / knowledge base: admin publishes articles via the rich text
// editor; public listing at /articles and detail pages at /articles/[slug])
// ---------------------------------------------------------------------------

model Article {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  // Featured image URL (admin pastes the image URL in the article form).
  featuredImage   String?
  // Rich text editor HTML output.
  content         String
  category        String
  tags            String[] @default([])
  metaTitle       String?
  metaDescription String?
  authorName      String
  publishDate     DateTime @db.Date
  isActive        Boolean  @default(true)
  isFeatured      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive, isFeatured, publishDate])
}

// ---------------------------------------------------------------------------
// Booking availability (admin blocks days/time slots for the public booking
// calendar; users cannot select blocked slots)
// ---------------------------------------------------------------------------

model BookingBlock {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  allDay    Boolean  @default(false)
  timeSlots String[] @default([])
  reason    String?
  createdAt DateTime @default(now())

  @@index([date])
}

// ---------------------------------------------------------------------------
// Orders / consultation bookings (created from the public booking modal and
// the product payment popup; every WhatsApp order intent is recorded here so
// admins can track, confirm and complete it from the dashboard)
// ---------------------------------------------------------------------------

model Order {
  id              String        @id @default(cuid())
  customerName    String
  phone           String
  whatsappNumber  String?
  email           String?
  itemName        String
  itemType        OrderItemType @default(SERVICE)
  amount          Decimal?      @db.Decimal(12, 2)
  amountLabel     String?
  preferredDate   String?
  preferredTime   String?
  preferredMode   String?
  birthDate       String?
  birthTime       String?
  birthPlace      String?
  note            String?
  deliveryAddress String?
  city            String?
  state           String?
  pincode         String?
  paymentMethod   String? // UPI | RAZORPAY | WHATSAPP | CASH
  paymentStatus   String? // PENDING | PAID | FAILED
  razorpayOrderId    String?
  razorpayPaymentId  String?
  razorpaySignature  String?
  courierName     String?
  trackingNumber  String?
  trackingUrl     String?
  trackingSentAt  DateTime?
  status          OrderStatus   @default(PENDING)
  source          String        @default("website")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([razorpayOrderId])
}

// ---------------------------------------------------------------------------
// Galleries
// ---------------------------------------------------------------------------

model GalleryImage {
  id          String   @id @default(cuid())
  title       String?
  description String?
  imageUrl    String
  altText     String?
  category    String?
  isFeatured  Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Video {
  id           String   @id @default(cuid())
  title        String
  description  String?
  videoUrl     String
  thumbnailUrl String?
  category     String?
  isFeatured   Boolean  @default(false)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model YoutubeVideo {
  id           String   @id @default(cuid())
  title        String
  description  String?
  youtubeId    String
  youtubeUrl   String
  thumbnailUrl String?
  category     String?
  isFeatured   Boolean  @default(false)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Testimonials
// ---------------------------------------------------------------------------

model Testimonial {
  id           String   @id @default(cuid())
  customerName String
  photoUrl     String?
  rating       Int      @default(5)
  text         String
  serviceRef   String?
  location     String?
  isApproved   Boolean  @default(false)
  isFeatured   Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Announcements (two scrolling bars)
// ---------------------------------------------------------------------------

model Announcement {
  id              String   @id @default(cuid())
  title           String?
  text            String
  textColor       String   @default("#FFFFFF")
  gradientColor   String?
  backgroundColor String   @default("#4C1D95")
  fontSize        Int      @default(16)
  fontStyle       String?
  speed           Int      @default(30)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Homepage sections & CMS
// ---------------------------------------------------------------------------

model HomepageSection {
  id         String   @id @default(cuid())
  sectionKey String   @unique
  title      String?
  subtitle   String?
  content    Json?
  settings   Json?
  isVisible  Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ThemeSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SeoSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SocialLink {
  id        String   @id @default(cuid())
  platform  String   @unique
  url       String
  icon      String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Newsletter subscribers
// ---------------------------------------------------------------------------

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  source    String   @default("footer")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model LegalPage {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  content       String
  seoTitle      String?
  seoDescription String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// FAQ (admin-managed accordion on the homepage)
// ---------------------------------------------------------------------------

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// ---------------------------------------------------------------------------
// Uploaded images (served from the database; used by the admin image uploader
// for logos, favicon, hero and astrologer photos - no manual URLs required)
// ---------------------------------------------------------------------------

model SiteImage {
  id        String   @id @default(cuid())
  filename  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Contact / Enquiries
// ---------------------------------------------------------------------------

model ContactMessage {
  id              String        @id @default(cuid())
  name            String
  phone           String
  whatsappNumber  String?
  serviceInterest String?
  message         String?
  preferredDate   String?
  preferredTime   String?
  status          RequestStatus @default(NEW)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}
